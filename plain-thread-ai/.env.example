# Supabase - Get from https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI Provider: "gemini" (free) or "openai" (paid)
AI_PROVIDER=gemini

# Gemini (free) - Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key

# Models (defaults)
AI_MODEL=gemini-2.0-flash
AI_MODEL_CHEAP=gemini-2.0-flash-lite

# OpenAI (optional, only needed if AI_PROVIDER=openai)
# OPENAI_API_KEY=sk-your_key
# AI_MODEL=gpt-4o
# AI_MODEL_CHEAP=gpt-4o-mini

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
